%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#1e293b", "primaryTextColor": "#f8fafc", "primaryBorderColor": "#475569", "lineColor": "#94a3b8", "secondaryColor": "#0f172a", "background": "#0f172a", "mainBkg": "#1e293b", "nodeBorder": "#475569", "clusterBkg": "#162032", "titleColor": "#f8fafc", "edgeLabelBackground": "#1e293b", "fontFamily": "monospace", "fontSize": "14px"}}}%%

graph LR
    subgraph SESSION["Debate Session"]
        direction TB
        RD["agora-run-debate"]
        AGENTS["Specialist Agents\n(tools: Read · Write · Edit)"]
        MEM["MEMORY.md\n(per-agent, self-managed)"]
        RD -->|"invokes each specialist\nin turn"| AGENTS
        AGENTS -->|"reads at turn start"| MEM
        AGENTS -->|"contributes analysis"| RD
        AGENTS -->|"updates at turn end\nif new patterns observed"| MEM
    end

    subgraph REVIEW_LOOP["Quality Improvement Loop"]
        direction TB
        REV["/agora-review-specialists\nAnalyze specialist transcripts\nScore adherence · specificity\nnovelty · impact · word count"]
        PROP["PROPOSAL-v{next}.md\nObserved issues + evidence\nProposed SKILL.md changes\nBreaking change analysis"]
        APPLY["/agora-apply-specialist-update\nPatch SKILL.md\nBump version\nCascade breaking changes"]
        CHNG["CHANGELOG.md\nVersion history entry\nSource session reference"]
        REV -->|"writes if severity ≠ none"| PROP
        PROP -->|"user reviews\nthen applies"| APPLY
        APPLY --> CHNG
        APPLY -->|"patch bump cascade"| AFFECTED["Affected specialists\n(if breaking change)"]
    end

    subgraph SKILL_FILE["Skill Definition  (.claude/skills/{specialist}/SKILL.md)"]
        direction TB
        FRONTMATTER["Frontmatter\nname · version · context: fork\nmodel: sonnet · author: Aryan Curiel\nuser-invocable: false"]
        BODY["Body\nRole definition\nDebate instructions\nSelf-managed memory"]
    end

    MEM -->|"accumulates across\nmultiple sessions"| MEM
    SESSION -->|"opt-in — user runs\nwhen needed"| REVIEW_LOOP
    APPLY -->|"patches body or instructions"| SKILL_FILE
    SKILL_FILE -->|"governs specialist behavior\neach session"| AGENTS

    style SESSION fill:#1e3a5f,stroke:#3b82f6,stroke-width:2px,color:#f8fafc
    style REVIEW_LOOP fill:#1a2e1a,stroke:#22c55e,stroke-width:2px,color:#f8fafc
    style SKILL_FILE fill:#2e1a1a,stroke:#ef4444,stroke-width:2px,color:#f8fafc
