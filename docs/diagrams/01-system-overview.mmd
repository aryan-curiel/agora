%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#1e293b", "primaryTextColor": "#f8fafc", "primaryBorderColor": "#334155", "lineColor": "#94a3b8", "secondaryColor": "#0f172a", "tertiaryColor": "#1e293b", "background": "#0f172a", "mainBkg": "#1e293b", "nodeBorder": "#475569", "clusterBkg": "#1e293b", "titleColor": "#f8fafc", "edgeLabelBackground": "#1e293b", "fontFamily": "monospace"}}}%%

graph TD
    User(["👤 User\n(Claude Code CLI)"])

    subgraph USER_SKILLS["User-Facing Skills"]
        direction TB
        ADD["/agora-add-idea\nStructured intake: name + 9 clarifying questions\nCreates ideas/{slug}/README.md with initial scores"]
        CONSTR["/agora-add-constraint\nAdds hard constraint to idea\nEnforced in all debate sessions"]
        LIST["/agora-list-ideas\nReads ideas_index.md\nShows scores + status"]
        SHOW["/agora-show-idea\nDisplays idea detail\nReadiness breakdown"]
        RUN["/agora-run-debate\nCore workflow orchestrator\n2–3 rounds · 40k token budget"]
        REVIEW["/agora-review-specialists\nAnalyzes specialist performance\nWrites PROPOSAL-v*.md files"]
        APPLY["/agora-apply-specialist-update\nPatches SKILL.md\nBumps version + CHANGELOG"]
        ARCH["/knowledge-architect\nArchitecture guidance\nfor extensions"]
    end

    subgraph FS["File System"]
        direction TB
        IDX["ideas_index.md\nMaster index + scores"]
        IDEA["ideas/{slug}/README.md\nIdea file + readiness scores\n+ session history"]
        SESSION["ideas/{slug}/sessions/\n{slug}-session-{n}-{date}.md\nFull transcript + report"]
        SKILLS_DIR[".claude/skills/{name}/\nSKILL.md · MEMORY.md\nCHANGELOG.md · PROPOSAL-v*.md"]
    end

    User -->|"add idea"| ADD
    User -->|"add constraint"| CONSTR
    User -->|"list ideas"| LIST
    User -->|"show idea"| SHOW
    User -->|"run debate"| RUN
    User -->|"review specialists"| REVIEW
    User -->|"apply update"| APPLY
    User -->|"design arch"| ARCH

    ADD -->|"creates"| IDEA
    ADD -->|"updates"| IDX
    CONSTR -->|"reads/updates"| IDEA
    LIST -->|"reads"| IDX
    SHOW -->|"reads"| IDEA
    RUN -->|"reads/updates"| IDEA
    RUN -->|"creates"| SESSION
    RUN -->|"updates"| IDX
    REVIEW -->|"reads"| SESSION
    REVIEW -->|"writes"| SKILLS_DIR
    APPLY -->|"patches"| SKILLS_DIR

    style CONSTR fill:#78350f,stroke:#f59e0b,stroke-width:2px,color:#f8fafc
    style USER_SKILLS fill:#1e3a5f,stroke:#3b82f6,stroke-width:2px,color:#f8fafc
    style FS fill:#1a2e1a,stroke:#22c55e,stroke-width:2px,color:#f8fafc
    style User fill:#4c1d95,stroke:#8b5cf6,stroke-width:2px,color:#f8fafc
